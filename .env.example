# Copy to .env and fill in. Never commit .env.

# Supabase -> Connect -> Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true only when the site is served over HTTPS.
SECURE_COOKIES=false

# Opens registration and bypasses every subscription check, so the whole
# flow can be demonstrated before payment. Leave false in production.
DEMO_MODE=false

# Failed sign-ins allowed per address before a cooldown.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300

# Let members of the public sign up as students on the main page, with no
# university behind them. They pay nothing; a company accepts them directly.
# Set to false to go back to institutions-only signup.
OPEN_STUDENT_SIGNUP=true

# Where submitted project files are written. Defaults to ./uploads.
#
# STRONGLY RECOMMENDED: point this OUTSIDE the project folder, e.g.
#     UPLOAD_FOLDER=C:\praxorax-uploads
# Otherwise replacing the code folder with a new build deletes every file
# students have submitted, while the database rows survive — and downloads
# start returning 410.
# On Render's free tier the disk is wiped on redeploy — attach a persistent
# disk, or move this to object storage, before you rely on it.
UPLOAD_FOLDER=

# Free days a university or company gets on signup, with no payment and no
# admin step. 0 switches trials off: new accounts start as 'pending' and wait
# for an administrator, nothing on the site offers a trial, and any trial
# already running still ends on its own date rather than being cut short.
# Set it to 7 to turn the free week back on — the copy that advertises it
# comes back with it.
TRIAL_DAYS=0

# The product name. Everything user-facing reads this.
BRAND=PraxoraX

# ----------------------------------------------------------------- email
# Alerts also go out by email when MAIL_ENABLED is true and a transport is
# configured. Supabase cannot send these — its email service only covers auth
# mail (confirmations, magic links, password resets).
#
# TWO WAYS OUT. Set MAIL_TRANSPORT, or leave it blank and it picks resend
# when RESEND_API_KEY is filled in and smtp otherwise.
#
# RESEND (recommended)
#   1. Sign up at resend.com and add your domain.
#   2. Add the DNS records it gives you and wait for it to say Verified.
#      Until it does, every send comes back "domain is not verified" — the
#      Alerts page will show you that message word for word.
#   3. Create an API key, put it in RESEND_API_KEY.
#   4. MAIL_FROM must be on that verified domain. An address at gmail.com
#      will be refused no matter how correct the key is.
#   MAIL_HOST, MAIL_PORT, MAIL_USER and MAIL_PASSWORD are all unused here.
#
# SMTP (any provider)
#   Gmail     smtp.gmail.com   port 587, STARTTLS, and an App Password
#             (not your normal password; 2FA must be on to create one)
#   Zoho      smtp.zoho.com    port 465 with MAIL_SSL=true
#   Brevo     smtp-relay.brevo.com  port 587
#
# Either way, press "Send me a test email" on the Alerts page once deployed.
# It goes out the same path as real mail and hands back the provider's own
# refusal rather than a shrug.
#
# Your real address in production — links inside emails are built from it.
BASE_URL=http://127.0.0.1:5000

MAIL_ENABLED=false

# resend | smtp  (blank picks resend when a key is set below)
MAIL_TRANSPORT=
RESEND_API_KEY=

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=praxorax@yourdomain.com
MAIL_REPLY_TO=
MAIL_STARTTLS=true
MAIL_SSL=false

# Send email in the request rather than on a background thread. Slower pages,
# but nothing can be lost to a process being recycled. Worth turning on for
# shared hosting such as cPanel; leave off elsewhere.
MAIL_SYNCHRONOUS=false

# ----------------------------------------------------------- presentations
# A student defends their project to the company over a video call. Times are
# typed and read in this timezone; the database stores UTC. Set it to where
# the institution actually is or everyone books an hour off.
TIMEZONE=Africa/Lagos

# The video server that hosts a defence. meet.jit.si needs no account and no
# API key, which is why it is the default — but it is a free public service
# that rate-limits embedded use and changes without notice. Point this at your
# own Jitsi install before a client depends on it. Anyone who prefers Zoom,
# Teams, Meet or Whereby pastes a link instead and nothing else changes.
JITSI_DOMAIN=meet.jit.si

# How far ahead a presentation must be booked, in minutes. Fifteen stops
# anyone confirming a meeting that is already starting. Set it to 0 while
# demonstrating the flow — you can then book a session for a minute from now
# and walk the whole thing through in one sitting — and put it back to 15
# before real users touch it. A time in the past is refused either way.
MIN_NOTICE_MINUTES=15

# ----------------------------------------------------------- idle timeout
# Sign someone out after this many minutes with no activity. Activity means
# the person did something — a page, a form, a click or a keystroke — not
# merely that a browser tab is open on the site. 0 switches it off.
#
# Keep it on anywhere a student might sign in on a shared library machine
# and walk away.
IDLE_TIMEOUT_MINUTES=20

# How many seconds before the deadline the warning appears, so a half-written
# submission is not lost without notice.
IDLE_WARN_SECONDS=90
