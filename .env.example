# Copy to .env and fill in. Never commit .env.

# Supabase -> Connect -> Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true only when the site is served over HTTPS.
SECURE_COOKIES=false

# Opens registration and bypasses every subscription check, so the whole
# flow can be demonstrated before payment. Leave false in production.
DEMO_MODE=false

# Failed sign-ins allowed per address before a cooldown.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300

# Let members of the public sign up as students on the main page, with no
# university behind them. They pay nothing; a company accepts them directly.
# Set to false to go back to institutions-only signup.
OPEN_STUDENT_SIGNUP=true

# Where submitted project files are written. Defaults to ./uploads.
#
# STRONGLY RECOMMENDED: point this OUTSIDE the project folder, e.g.
#     UPLOAD_FOLDER=C:\praxorax-uploads
# Otherwise replacing the code folder with a new build deletes every file
# students have submitted, while the database rows survive — and downloads
# start returning 410.
# On Render's free tier the disk is wiped on redeploy — attach a persistent
# disk, or move this to object storage, before you rely on it.
UPLOAD_FOLDER=

# Free days a university or company gets on signup, with no payment and no
# admin step. 0 switches trials off; trials already running still finish.
TRIAL_DAYS=7

# The product name. Everything user-facing reads this.
BRAND=PraxoraX

# ----------------------------------------------------------------- email
# Alerts also go out by email when MAIL_ENABLED is true and a host is set.
#
# Supabase cannot send these. Its email service only covers auth mail —
# confirmations, magic links, password resets — so this talks to an SMTP
# server directly. Any provider works.
#
#   Gmail     smtp.gmail.com   port 587, STARTTLS, and an App Password
#             (not your normal password; 2FA must be on to create one)
#   Zoho      smtp.zoho.com    port 465 with MAIL_SSL=true
#   Brevo     smtp-relay.brevo.com  port 587
#
# Your real address in production — links inside emails are built from it.
BASE_URL=http://127.0.0.1:5000

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=praxorax@yourdomain.com
MAIL_REPLY_TO=
MAIL_STARTTLS=true
MAIL_SSL=false

# Send email in the request rather than on a background thread. Slower pages,
# but nothing can be lost to a process being recycled. Worth turning on for
# shared hosting such as cPanel; leave off elsewhere.
MAIL_SYNCHRONOUS=false
